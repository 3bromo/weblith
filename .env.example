# ─────────────────────────────────────────────────────────────
# Weblith environment variables
# Copy this file to `.env.local` and fill in real values.
# No credentials ship with this repository — all features below
# stay dormant until you configure them.
# ─────────────────────────────────────────────────────────────

# ── Supabase: authentication + database (Phase 2) ────────────
# Create a project at https://supabase.com → Project Settings → API.
# While these are empty, /login and /signup show a configuration
# notice instead of authenticating anyone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Never expose with a NEXT_PUBLIC_
# prefix. Used later for privileged server-side operations
# (e.g. publishing, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL (SEO) ──────────────────────────────────────────
# Canonical origin used for sitemap/OG URLs once deployed.
SITE_URL=

# ── AI generation (future phase) ─────────────────────────────
# POST /api/generate validates requests but returns 501 until a
# server-side provider is configured. Keys must never be exposed
# to the browser.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
